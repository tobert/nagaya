// SPDX-License-Identifier: MIT
// The layout of a stage and the constants of the schedule, for the two languages (milestone 15 step 5).
// stage_layout.h checks each line against the C++ types with static_assert. The Rust build (build.rs) makes the Rust
// constants from the STAGE_CONST lines, and checks the Rust mirror (src/stage.rs) against the other lines.
// Change a line here only together with the C++ type and the Rust mirror. A difference stops one of the two builds.
//   STAGE_SIZE(type, bytes)                 sizeof the type
//   STAGE_FIELD(type, field, offset)        offsetof the field
//   STAGE_UNION(type, field, rust, offset)  offsetof a member of the anonymous union; the Rust union field is `rust`
//   STAGE_CONST(c++ name, RUST_NAME, value) a u32 constant
STAGE_SIZE(Stage, 528)
STAGE_FIELD(Stage, op, 0)
STAGE_FIELD(Stage, layer, 4)
STAGE_FIELD(Stage, sub, 8)
STAGE_FIELD(Stage, sched, 12)
STAGE_UNION(Stage, qmm, args, 16)
