# The nagaya as a systemd user unit on the Strix Halo example (docs/spec.md 10.1; docs/deploy.md has the install).
# Install: copy this file to ~/.config/systemd/user/nagaya.service, and change the address, the paths and the
#          models. Copy `deploy/strix-halo/nagaya.toml` to ~/.config/nagaya/nagaya.toml, and `profile.toml` into
#          the store directory. Then `systemctl --user daemon-reload` (docs/deploy.md).
# The unit is a copy, not a link, so a pull of the repository never changes a running machine.
# Rebuild the release binary before each restart, with `--features hip`: the unit runs the file in `target/release`.
# `cargo build --release -p nagaya --features hip`. A build without the feature has no engine and exits 3.
# The nagaya is the only GPU client (spec 3.1).
[Unit]
Description=nagaya: the engines of this machine behind council v2 (port 8090)
# A user unit cannot order itself after a system unit, such as one that sets the address. The wait in ExecStartPre
# covers it.
After=network-online.target
Wants=network-online.target
# A crash loop must not hit the GPU again and again: three starts in 10 minutes, and the unit stays down.
# systemd counts a start after exit 4 too, so a fourth profile swap in 600 s fails (spec 10.4).
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
# The process sends READY=1 when the resident engines have loaded their weights. A load can wait up to 60 s for free
# memory, then it takes about 35 s.
TimeoutStartSec=300
WorkingDirectory=%h/src/nagaya
# The bootstrap config (spec 2.1). It names the bind addresses and the store directory.
Environment=NAGAYA_CONFIG=%h/.config/nagaya/nagaya.toml
# The three GGUF shards of the Qwen3.8 engine, with : between them. The binary links the engine, so no variable names
# a library.
Environment="QWEN38_SHARDS=/srv/models/Qwen3.8-Flash-Next-GGUF/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf:/srv/models/Qwen3.8-Flash-Next-GGUF/Qwen3.8-Flash-Next-UD-IQ4_XS-00002-of-00003.gguf:/srv/models/Qwen3.8-Flash-Next-GGUF/Qwen3.8-Flash-Next-UD-IQ4_XS-00003-of-00003.gguf"
# Unset on purpose: QWEN38_FAST_QMM (the fast path). docs/deploy.md says how to set it.
# OpenTelemetry: OTLP over gRPC to a collector on 4317 (spec 9.1). The exporter speaks gRPC, not OTLP/HTTP on 4318.
# Without a collector, remove the line: the exporter logs a transport error every 5 s. Without it, stderr only.
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# The store directory must exist before the process reads its profile. It is `store_dir` of the config.
ExecStartPre=/usr/bin/mkdir -p /srv/nagaya/store
# At boot the address can come after the user manager starts the unit. A bind to a missing address exits 3 and
# keeps the unit down (spec 10.4), so wait for the address of `http_bind`. TimeoutStartSec covers the 120 s.
ExecStartPre=%h/src/nagaya/deploy/wait-address.sh 192.0.2.10 120
ExecStart=%h/src/nagaya/target/release/nagaya
# Arenas through a restart (spec 10.2): the Qwen3.8 engine exports no arena, so the unit sets no fd store.
# SIGTERM: the running quantum ends (at most 10 s), then the park runs (10 s by default). A second signal ends it now.
KillSignal=SIGTERM
TimeoutStopSec=60
# Spec 10.4. Exit 1 is a crash: start again, but not in a tight loop. Exit 3 is a refusal that repeats on every
# start, so the unit stays down. Exit 4 is a planned restart after a profile swap (spec 3.3), and it always restarts.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=3
RestartForceExitStatus=4

[Install]
WantedBy=default.target
